# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_TELEGRAM_BOT_TOKEN: Telegram Bot Token from BotFather
VITE_TELEGRAM_BOT_TOKEN=""

# VITE_TELEGRAM_CHAT_ID: Group or User Chat ID exclusively for attendance notifications (check-in, check-out)
VITE_TELEGRAM_CHAT_ID=""

# VITE_TELEGRAM_ADMIN_CHAT_ID: Comma-separated Chat IDs for sensitive admin alerts (requests, approvals, payroll, new staff)
VITE_TELEGRAM_ADMIN_CHAT_ID=""

# BAKONG_ACCOUNT_ID: The Bakong Account ID to receive KHQR payments (e.g. dev@aclb)
BAKONG_ACCOUNT_ID=""

# BAKONG_EMAIL: Registered email for Bakong Open API token renewal
BAKONG_EMAIL=""

# BAKONG_BASE_URL: Bakong API Base URL (e.g. https://api-bakong.nbc.gov.kh)
BAKONG_BASE_URL="https://api-bakong.nbc.gov.kh"

# VITE_GOOGLE_MAPS_API_KEY: Required for Office Location setup map
VITE_GOOGLE_MAPS_API_KEY=""

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email Configuration (using SMTP - adjust for your provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=myphoto9459@gmail.com
SMTP_PASS=""
SMTP_FROM_NAME=Kiri HR
SMTP_FROM_EMAIL=kirihrsystem@gmail.com

# Optional: If using a different email service like SendGrid
# SENDGRID_API_KEY=SG.xxxxxx
# SENDGRID_FROM_EMAIL=noreply@kirihr.com

# Base URL for Stripe success/return pages
NEXT_PUBLIC_APP_URL=https://kirihr.com