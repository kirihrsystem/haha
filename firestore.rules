rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /companies_settings/{docId} {
      allow read, write: if true;
    }
    match /staff/{staffId} {
      allow read, write: if true;
    }
    match /logs/{logId} {
      allow read, write: if true;
    }
    match /bonuses/{bonusId} {
      allow read, write: if true;
    }
    match /notifications/{notifId} {
      allow read, write: if true;
    }
    match /permissions/{permId} {
      allow read, write: if true;
    }
    match /revenues/{revId} {
      allow read, write: if true;
    }
    match /coupons/{couponId} {
      allow read, write: if true;
    }
    match /scheduled_reports/{reportId} {
      allow read, write: if true;
    }
    match /report_logs/{logId} {
      allow read, write: if true;
    }
    match /direct_messages/{messageId} {
      allow read, write: if true;
    }
    match /telegram_knowledge/{docId} {
      allow read, write: if true;
    }
    match /testimonials/{testimonialId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
